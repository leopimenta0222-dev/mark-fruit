{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mark Fruit: Rodar site",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "windows": {
        "options": {
          "shell": { "executable": "cmd.exe", "args": ["/c"] },
          "cwd": "${workspaceFolder}/frontend"
        }
      },
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      "label": "Mark Fruit: Instalar dependências",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "windows": {
        "options": {
          "shell": { "executable": "cmd.exe", "args": ["/c"] },
          "cwd": "${workspaceFolder}/frontend"
        }
      },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
