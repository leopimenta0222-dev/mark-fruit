# Copie este arquivo para .env e preencha os valores

# String de conexão do PostgreSQL.
# Local: você vai colar aqui a URL do banco criado no Render (aba "External Database URL").
# Em produção (Render): a própria Render preenche isso automaticamente.
DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco"

# Segredo para assinar os tokens JWT. Use uma frase longa e aleatória.
JWT_SECRET="troque-isto-por-uma-frase-longa-e-aleatoria"

# Porta do servidor. Em produção a Render define automaticamente.
PORT=3001

# URL(s) do frontend liberadas no CORS. Separe por vírgula se houver mais de uma.
# Em desenvolvimento pode deixar em branco (libera tudo).
# Em produção: https://seu-projeto.vercel.app
FRONTEND_URL=
