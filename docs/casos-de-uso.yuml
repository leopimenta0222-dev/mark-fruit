// =============================================================
// Mark Fruit - Diagrama de Casos de Uso (yUML)
//
// COMO USAR:
//
// 1. Acesse: https://yuml.me/diagram/nofunky/usecase/edit
//    (nofunky = estilo limpo, com linhas retas; mais profissional)
//
// 2. Apague o exemplo padrao do editor
//
// 3. Copie TODO o codigo abaixo a partir da linha "// === HERANCA ==="
//    (pode ignorar os comentarios "//", o yUML ignora eles)
//
// 4. Cole no editor - o diagrama aparece automaticamente
//
// 5. Botao direito na imagem -> "Salvar imagem como..." (PNG ou SVG)
//
// Para outros estilos, na URL troque "nofunky" por:
//   - scruffy   (desenhado a mao, mais descontraido)
//   - plain     (preto e branco simples)
// =============================================================

// === HERANCA DE ATORES ===
// Consumidor e Produtor herdam de Visitante:
// podem fazer tudo que o Visitante faz (Cadastrar-se, Login, Pesquisar...)
[Visitante]^-[Consumidor]
[Visitante]^-[Produtor]

// === ACESSO PUBLICO (verde) — Visitante e herdeiros ===
[Visitante]-(Cadastrar-se{bg:palegreen})
[Visitante]-(Fazer login{bg:palegreen})
[Visitante]-(Pesquisar produtos{bg:palegreen})
[Visitante]-(Visualizar anuncio{bg:palegreen})
[Visitante]-(Consultar bot Como Plantar{bg:palegreen})

// === EXCLUSIVO CONSUMIDOR (azul) ===
[Consumidor]-(Avaliar produto{bg:lightblue})

// === COMUM AOS DOIS LOGADOS (amarelo) ===
[Consumidor]-(Sair{bg:lightyellow})
[Consumidor]-(Gerenciar perfil{bg:lightyellow})
[Consumidor]-(Conversar{bg:lightyellow})
[Produtor]-(Sair{bg:lightyellow})
[Produtor]-(Gerenciar perfil{bg:lightyellow})
[Produtor]-(Conversar{bg:lightyellow})

// === EXCLUSIVO PRODUTOR (rosa) ===
[Produtor]-(Criar anuncio{bg:lightpink})
[Produtor]-(Editar anuncio{bg:lightpink})
[Produtor]-(Excluir anuncio{bg:lightpink})
