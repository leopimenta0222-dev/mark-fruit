@startuml CasosDeUsoMarkFruit
' Mark Fruit - Diagrama de Casos de Uso
' Cole este codigo em https://www.plantuml.com/plantuml/uml/ ou https://planttext.com/

skinparam backgroundColor #FFFFFF
skinparam usecase {
    BackgroundColor #DCFCE7
    BorderColor #16A34A
    ArrowColor #44403C
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #16A34A
}
skinparam rectangle {
    BackgroundColor #FAFAF9
    BorderColor #A8A29E
}
skinparam packageStyle rectangle

left to right direction
title Sistema Mark Fruit - Casos de Uso

' === Atores ===
actor "Visitante" as V
actor "Consumidor" as C
actor "Produtor" as P

' Heranca: Consumidor e Produtor sao usuarios autenticados
' (herdam tudo que o Visitante pode fazer)
V <|-- C
V <|-- P

' === Sistema ===
rectangle "Sistema Mark Fruit" {

    ' Acesso (publico - Visitante)
    usecase "Cadastrar-se" as UC1
    usecase "Fazer login" as UC2
    usecase "Buscar produtos" as UC3
    usecase "Visualizar anúncio" as UC4
    usecase "Consultar bot\n'Como Plantar'" as UC5

    ' Conta autenticada (Consumidor e Produtor)
    usecase "Sair" as UC6
    usecase "Editar perfil" as UC7
    usecase "Atualizar\nlocalização" as UC8
    usecase "Ver minhas\nconversas" as UC9

    ' Consumidor
    usecase "Avaliar produto" as UC10
    usecase "Remover\navaliação" as UC11
    usecase "Iniciar conversa\ncom produtor" as UC12
    usecase "Enviar mensagem" as UC13

    ' Produtor
    usecase "Criar anúncio" as UC14
    usecase "Editar anúncio" as UC15
    usecase "Excluir anúncio" as UC16
    usecase "Responder\nmensagens" as UC17
}

' === Relacoes do Visitante ===
V --> UC1
V --> UC2
V --> UC3
V --> UC4
V --> UC5

' === Relacoes comuns (Consumidor e Produtor) ===
C --> UC6
C --> UC7
C --> UC8
C --> UC9
P --> UC6
P --> UC7
P --> UC8
P --> UC9

' === Especificas do Consumidor ===
C --> UC10
C --> UC11
C --> UC12
C --> UC13

' === Especificas do Produtor ===
P --> UC14
P --> UC15
P --> UC16
P --> UC17

' === Relacionamento <<include>> verdadeiro ===
' Iniciar uma conversa sempre envolve enviar a primeira mensagem.
UC12 ..> UC13 : <<include>>

@enduml
